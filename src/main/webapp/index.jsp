<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Bug Bounty Management System</title>

    <link rel="stylesheet" href="css/style.css">
</head>

<body>

    <!-- Navigation Bar -->

    <nav class="navbar">

        <div class="logo">
            🛡️ BugBounty
        </div>

        <div class="nav-links">
            <a href="index.jsp">Home</a>
            <a href="login.jsp">Login</a>
            <a href="register.jsp">Register</a>
        </div>

    </nav>


    <!-- Hero Section -->

    <section class="hero">

        <div class="hero-content">

            <p class="tagline">
                SECURE • REPORT • REWARD
            </p>

            <h1>
                Bug Bounty<br>
                Management System
            </h1>

            <p class="description">
                A secure platform for ethical hackers to report
                vulnerabilities and for organizations to manage
                security reports efficiently.
            </p>

            <div class="buttons">

                <a href="login.jsp" class="btn primary">
                    Login
                </a>

                <a href="register.jsp" class="btn secondary">
                    Register
                </a>

            </div>

        </div>

    </section>


    <!-- Features -->

    <section class="features">

        <h2>How It Works</h2>

        <div class="feature-container">

            <div class="feature-card">
                <div class="icon">🐞</div>
                <h3>Report Bugs</h3>
                <p>
                    Ethical hackers can securely submit
                    vulnerability reports.
                </p>
            </div>

            <div class="feature-card">
                <div class="icon">🔍</div>
                <h3>Review Reports</h3>
                <p>
                    Organizations can review and verify
                    submitted vulnerabilities.
                </p>
            </div>

            <div class="feature-card">
                <div class="icon">💰</div>
                <h3>Earn Rewards</h3>
                <p>
                    Verified vulnerabilities can receive
                    appropriate rewards.
                </p>
            </div>

        </div>

    </section>


    <!-- Footer -->

    <footer>

        <p>
            © 2026 Bug Bounty Management System
        </p>

    </footer>

</body>

</html>